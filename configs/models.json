{
  "work_dir": "/data/models",
  "modelscope_bin": "modelscope",
  "models": [
    {
      "id": "qwen2.5-7b-instruct-bf16",
      "modelscope_repo": "Qwen/Qwen2.5-7B-Instruct",
      "local_dir": "Qwen2.5-7B-Instruct",
      "quantize": {
        "enabled": false
      },
      "deploy": {
        "container_name": "vllm-qwen25-7b-bf16",
        "image": "vllm/vllm-openai:v0.9.2",
        "host_port": 8000,
        "container_port": 8000,
        "gpu_memory_utilization": 0.85,
        "max_model_len": 4096,
        "dtype": "bfloat16",
        "shm_size_mb": 2048,
        "extra_args": []
      }
    },
    {
      "id": "qwen2.5-7b-instruct-awq",
      "modelscope_repo": "Qwen/Qwen2.5-7B-Instruct",
      "local_dir": "Qwen2.5-7B-Instruct",
      "quantize": {
        "enabled": true,
        "method": "awq",
