      "deploy": {
        "container_name": "vllm-qwen25-7b-awq",
        "image": "vllm/vllm-openai:v0.9.2",
        "host_port": 8002,
        "container_port": 8000,
        "gpu_memory_utilization": 0.40,
        "max_model_len": 4096,
        "dtype": "float16",
        "quantization": "awq",
        "shm_size_mb": 2048,
        "extra_args": []
      }
    },
    {
      "id": "llama3-8b-instruct-bf16",
      "modelscope_repo": "LLM-Research/Meta-Llama-3-8B-Instruct",
